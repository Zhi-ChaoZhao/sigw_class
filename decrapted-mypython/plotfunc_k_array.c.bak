int main(int argc, char *argv[]) {
    // Initialize the Python Interpreter
    Py_Initialize();

    // Call the new function
    Py_initial_FNLGNLHNL_code();

    // Define parameters
    double sigma = 1.0;
    double A = 3.6e-3;
    double FNL = 5.0;

    // Call the C_call_total function and get the result
    PyObject *result = call_C_call_total(sigma, A, FNL);

    if (result != NULL) {
        PyObject *pArray1 = PyTuple_GetItem(result, 0);
        PyObject *pArray2 = PyTuple_GetItem(result, 1);
        PyObject *pArray1Str = PyObject_Str(pArray1);
        PyObject *pArray2Str = PyObject_Str(pArray2);
        printf("total toArray 1: %s\n", PyUnicode_AsUTF8(pArray1Str));
        printf("total toArray 2: %s\n", PyUnicode_AsUTF8(pArray2Str));
        Py_DECREF(pArray1Str);
        Py_DECREF(pArray2Str);
        Py_DECREF(result);
    }

    // Call the C_call_ob function and get the result
    PyObject *result2 = call_C_call_ob(sigma, A, FNL);

    if (result2 != NULL) {
        PyObject *pArray1 = PyTuple_GetItem(result2, 0);
        PyObject *pArray2 = PyTuple_GetItem(result2, 1);
        PyObject *pArray1Str = PyObject_Str(pArray1);
        PyObject *pArray2Str = PyObject_Str(pArray2);
        printf("ob toArray 1: %s\n", PyUnicode_AsUTF8(pArray1Str));
        printf("ob toArray 2: %s\n", PyUnicode_AsUTF8(pArray2Str));
        Py_DECREF(pArray1Str);
        Py_DECREF(pArray2Str);
        Py_DECREF(result2);
    } else {
        printf("Call C_call_ob failed\n");
    }

    // Call the C_call_ng1 function and get the result
    PyObject *result3 = call_C_call_ng1(sigma, A, FNL);

    if (result3 != NULL) {
        PyObject *pArray1 = PyTuple_GetItem(result3, 0);
        PyObject *pArray2 = PyTuple_GetItem(result3, 1);
        PyObject *pArray1Str = PyObject_Str(pArray1);
        PyObject *pArray2Str = PyObject_Str(pArray2);
        printf("ng1 toArray 1: %s\n", PyUnicode_AsUTF8(pArray1Str));
        printf("ng1 toArray 2: %s\n", PyUnicode_AsUTF8(pArray2Str));
        Py_DECREF(pArray1Str);
        Py_DECREF(pArray2Str);
        Py_DECREF(result3);
    } else {
