void Py_initial_FNLGNLHNL_code() {
    // Initialize the NumPy API
    import_array(); // Added line

    // Add . to the Python path
    PyRun_SimpleString("import sys");
    PyRun_SimpleString("sys.path.append('.')");

    // Import plotfunc and its functions
    PyObject *pModule = PyImport_ImportModule("plotfunc");
    if (pModule == NULL) {
        fprintf(stderr, "Failed to import plotfunc module\n");
        return;
    }

    // Call the readdata function without any arguments
    PyObject *pReaddataFunc = PyObject_GetAttrString(pModule, "readdata");
    if (PyCallable_Check(pReaddataFunc)) {
        PyObject *pArgs = PyTuple_New(1);
        PyTuple_SetItem(pArgs, 0, Py_BuildValue("i", 1));
        PyObject *pValue = PyObject_CallObject(pReaddataFunc, pArgs);
        if (pValue != NULL) {
            printf("Result of readdata call: %ld\n", PyLong_AsLong(pValue));
            Py_DECREF(pValue);
        } else {
            PyErr_Print();
        }
        Py_DECREF(pArgs);
    } else {
        printf("Call readdata failed\n");
    }
    
    // Clean up
    Py_DECREF(pReaddataFunc);
    Py_DECREF(pModule);
}

PyObject* call_C_call_total(double sigma, double A, double FNL) {
    // Import plotfunc and its functions
    PyObject *pModule = PyImport_ImportModule("plotfunc");
    if (pModule == NULL) {
        fprintf(stderr, "Failed to import plotfunc module\n");
        return NULL;
    }

    // Call the C_call_total function
    PyObject *pFunc = PyObject_GetAttrString(pModule, "C_call_total");
    if (PyCallable_Check(pFunc)) {
        PyObject *pArgs = PyTuple_New(3);
        PyTuple_SetItem(pArgs, 0, Py_BuildValue("d", sigma)); // sigma
        PyTuple_SetItem(pArgs, 1, Py_BuildValue("d", A)); // A
        PyTuple_SetItem(pArgs, 2, Py_BuildValue("d", FNL)); // FNL

        PyObject *pValue = PyObject_CallObject(pFunc, pArgs);
        Py_DECREF(pArgs);
        if (pValue != NULL) {
            if (PyTuple_Check(pValue) && PyTuple_Size(pValue) == 2) {
                PyObject *pArray1 = PyTuple_GetItem(pValue, 0);
                PyObject *pArray2 = PyTuple_GetItem(pValue, 1);
                if (PyArray_Check(pArray1) && PyArray_Check(pArray2)) {
                    Py_INCREF(pArray1);
                    Py_INCREF(pArray2);
                    Py_DECREF(pValue);
                    Py_DECREF(pFunc);
                    Py_DECREF(pModule);
                    return PyTuple_Pack(2, pArray1, pArray2);
                } else {
                    printf("Result of call: Unexpected return types\n");
                }
            } else {
                printf("Result of call: Unexpected return value\n");
            }
            Py_DECREF(pValue);
        } else {
            PyErr_Print();
        }
        Py_DECREF(pFunc);
    } else {
        printf("Call C_call_total failed\n");
    }

    Py_DECREF(pModule);
    return NULL;
}

